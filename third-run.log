#!/usr/bin/env python3
"""Parse QE bands.x output, report the Si indirect gap, and plot bands.png."""

import json
import math
import re
from pathlib import Path

import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt


ROOT = Path(__file__).resolve().parent
N_OCCUPIED_BANDS = 4
GAP_ACCEPTANCE_EV = (0.5, 0.8)


def parse_bands_dat(path):
    lines = [line.strip() for line in path.read_text().splitlines() if line.strip()]
    if not lines:
        raise RuntimeError(f"No content found in {path}")
    header = lines[0]
    nbnd_match = re.search(r"nbnd\s*=\s*(\d+)", header)
    nks_match = re.search(r"nks\s*=\s*(\d+)", header)
    if not nbnd_match or not nks_match:
        raise RuntimeError(f"Could not read nbnd/nks from {path} header")
    nbnd = int(nbnd_match.group(1))
    nks = int(nks_match.group(1))

    kcoords = []
    energies_by_k = []
    i = 1
    for _ in range(nks):
        if i >= len(lines):
            raise RuntimeError("Unexpected end of bands.dat while reading k-points")
        kcoord = [float(x) for x in lines[i].split()[:3]]
        i += 1
        energies = []
        while len(energies) < nbnd:
            if i >= len(lines):
                raise RuntimeError("Unexpected end of bands.dat while reading energies")
            energies.extend(float(x) for x in lines[i].split())
            i += 1
        kcoords.append(kcoord)
        energies_by_k.append(energies[:nbnd])

    xs = [0.0]
    for previous, current in zip(kcoords[:-1], kcoords[1:]):
        xs.append(xs[-1] + math.dist(previous, current))
    energies_by_band = [
        [energies_by_k[ik][ib] for ik in range(nks)] for ib in range(nbnd)
    ]
    return xs, energies_by_band


def parse_scf_iterations(path):
    if not path.exists():
        return None
    text = path.read_text(errors="ignore")
    matches = re.findall(r"iteration\s+#\s*(\d+)", text)
    return int(matches[-1]) if matches else None


def band_extrema(xs, energies_by_band):
    vbm = {"energy_ev": -math.inf, "band_index_1based": None, "k_index": None, "x": None}
    cbm = {"energy_ev": math.inf, "band_index_1based": None, "k_index": None, "x": None}

    for band_index, band in enumerate(energies_by_band, start=1):
        for k_index, energy in enumerate(band):
            if band_index <= N_OCCUPIED_BANDS and energy > vbm["energy_ev"]:
                vbm = {
                    "energy_ev": energy,
                    "band_index_1based": band_index,
                    "k_index": k_index,
                    "x": xs[k_index],
                }
            if band_index > N_OCCUPIED_BANDS and energy < cbm["energy_ev"]:
                cbm = {
                    "energy_ev": energy,
                    "band_index_1based": band_index,
                    "k_index": k_index,
                    "x": xs[k_index],
                }
    return vbm, cbm, cbm["energy_ev"] - vbm["energy_ev"]


def make_plot(xs, energies_by_band, vbm, cbm, gap_ev, kpath):
    tick_indices = kpath["label_indices"]
    tick_labels = ["$\\Gamma$" if label == "G" else label for label in kpath["labels"]]
    tick_positions = [xs[i] for i in tick_indices]

    fig, ax = plt.subplots(figsize=(7.2, 4.8), dpi=180)
    for band in energies_by_band:
        ax.plot(xs, [energy - vbm["energy_ev"] for energy in band], color="black", lw=0.9)

    for xpos in tick_positions:
        ax.axvline(xpos, color="0.75", lw=0.7)
    ax.axhline(0.0, color="#2563eb", lw=0.8, ls="--")
    ax.scatter([vbm["x"]], [0.0], color="#2563eb", s=18, zorder=4)
    ax.scatter([cbm["x"]], [cbm["energy_ev"] - vbm["energy_ev"]], color="#dc2626", s=18, zorder=4)
    ax.text(
        0.985,
        0.96,
        f"Indirect gap = {gap_ev:.3f} eV",
        ha="right",
        va="top",
        transform=ax.transAxes,
        fontsize=9,
    )
    ax.set_xlim(min(xs), max(xs))
    ax.set_ylim(-5.0, 5.0)
    ax.set_xticks(tick_positions, tick_labels)
    ax.set_ylabel("Energy - VBM (eV)")
    ax.set_xlabel("Lattice wave vector")
    ax.set_title("Si diamond PBE band structure")
    ax.grid(axis="y", color="0.88", lw=0.5)
    fig.tight_layout()
    fig.savefig(ROOT / "bands.png")


def main():
    xs, energies_by_band = parse_bands_dat(ROOT / "bands.dat")
    kpath = json.loads((ROOT / "kpath.json").read_text())
    vbm, cbm, gap_ev = band_extrema(xs, energies_by_band)
    accepted = GAP_ACCEPTANCE_EV[0] <= gap_ev <= GAP_ACCEPTANCE_EV[1]
    scf_iterations = parse_scf_iterations(ROOT / "scf.out")

    make_plot(xs, energies_by_band, vbm, cbm, gap_ev, kpath)

    result = {
        "n_kpoints": len(xs),
        "n_bands": len(energies_by_band),
        "occupied_bands_assumed": N_OCCUPIED_BANDS,
        "vbm": vbm,
        "cbm": cbm,
        "indirect_gap_ev": gap_ev,
        "acceptance_window_ev": list(GAP_ACCEPTANCE_EV),
        "gap_in_acceptance_window": accepted,
        "scf_iterations": scf_iterations,
        "scf_converged_within_30": scf_iterations is not None and scf_iterations <= 30,
        "plot": "bands.png",
        "parsed_source": "bands.dat",
    }
    (ROOT / "band_analysis.json").write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps(result, indent=2))
    if not accepted:
        raise SystemExit(f"Gap {gap_ev:.3f} eV outside requested window {GAP_ACCEPTANCE_EV}")


if __name__ == "__main__":
    main()
