+#!/usr/bin/env python3
+"""Generate VASP inputs for Si diamond PBE band-structure parity test."""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+from pathlib import Path
+
+
+PROJECT = Path(__file__).resolve().parent
+REPO_ROOT = PROJECT.parents[1]
+
+A_ANG = 5.43
+SYSTEM_TAG = "Si_diamond_PBE_band_vasp"
+POINTS_PER_SEGMENT = 36
+POTCAR_DEFAULT = Path("/home/werner/Public/hpc/vasp/pot/potpaw_PBE/Si/POTCAR")
+
+KPAR = 2
+NCORE = 4
+ENCUT_EV = 400
+EDIFF = "1E-6"
+
+K_NODES = [
+    ("L", (0.5, 0.5, 0.5)),
+    ("G", (0.0, 0.0, 0.0)),
+    ("X", (0.5, 0.0, 0.5)),
+    ("W", (0.5, 0.25, 0.75)),
+    ("K", (0.375, 0.375, 0.75)),
+    ("G", (0.0, 0.0, 0.0)),
+]
+
+
+def write(path: Path, text: str) -> None:
+    path.write_text(text.strip() + "\n")
+
+
+def choose_potcar() -> Path:
+    explicit = os.environ.get("VASP_SI_POTCAR")
+    if explicit:
+        candidate = Path(explicit)
+    else:
+        vasp_pp = os.environ.get("VASP_PP")
+        candidate = Path(vasp_pp) / "potpaw_PBE" / "Si" / "POTCAR" if vasp_pp else POTCAR_DEFAULT
+    if not candidate.is_file():
+        raise FileNotFoundError(
+            f"Si standard PAW PBE POTCAR not found at {candidate}. "
+            "Set VASP_PP or VASP_SI_POTCAR before running."
+        )
+    return candidate
+
+
+def potcar_enmax(path: Path) -> float | None:
+    text = path.read_text(errors="ignore")
+    match = re.search(r"ENMAX\s*=\s*([0-9.]+)", text)
+    return float(match.group(1)) if match else None
+
+
+def main() -> None:
+    incar_common = f"""
+SYSTEM = {SYSTEM_TAG}
+PREC = Accurate
+ENCUT = {ENCUT_EV}
+EDIFF = {EDIFF}
+NELM = 100
+ALGO = Normal
+IBRION = -1
+NSW = 0
+ISMEAR = 0
+SIGMA = 0.05
+LREAL = .FALSE.
+LWAVE = .FALSE.
+KPAR = {KPAR}
+NCORE = {NCORE}
+"""
+    incar_scf = f"""
+{incar_common}
+ICHARG = 2
+LCHARG = .TRUE.
+ISYM = 2
+"""
+    incar_band = f"""
+{incar_common}
+ICHARG = 11
+LCHARG = .FALSE.
+ISYM = 0
+LORBIT = 11
+NBANDS = 12
+"""
+    write(PROJECT / "INCAR_scf", incar_scf)
+    write(PROJECT / "INCAR_band", incar_band)
+
+    half = A_ANG / 2.0
+    poscar = f"""
+Si diamond primitive PBE band structure, a={A_ANG:.2f} Angstrom
+1.0
+  0.0000000000  {half:.10f}  {half:.10f}
+  {half:.10f}  0.0000000000  {half:.10f}
+  {half:.10f}  {half:.10f}  0.0000000000
+Si
+2
+Direct
+  0.0000000000  0.0000000000  0.0000000000
+  0.2500000000  0.2500000000  0.2500000000
+"""
+    write(PROJECT / "POSCAR", poscar)
+
+    kpoints_scf = """
+Si diamond SCF Gamma-centered 8x8x8
+0
+Gamma
+  8  8  8
+  0  0  0
+"""
+    write(PROJECT / "KPOINTS_scf", kpoints_scf)
+
+    path_lines = []
+    for (label_a, coord_a), (label_b, coord_b) in zip(K_NODES[:-1], K_NODES[1:]):
+        path_lines.append(
+            f"  {coord_a[0]: .10f} {coord_a[1]: .10f} {coord_a[2]: .10f} ! {label_a}"
+        )
+        path_lines.append(
+            f"  {coord_b[0]: .10f} {coord_b[1]: .10f} {coord_b[2]: .10f} ! {label_b}"
+        )
+        path_lines.append("")
+    kpoints_band = f"""
+Si diamond band path L-G-X-W-K-G, {POINTS_PER_SEGMENT} points per segment
+{POINTS_PER_SEGMENT}
+Line-mode
+Reciprocal
+{chr(10).join(path_lines)}
+"""
+    write(PROJECT / "KPOINTS_band", kpoints_band)
+
+    potcar_src = choose_potcar()
+    shutil.copyfile(potcar_src, PROJECT / "POTCAR")
+    enmax = potcar_enmax(PROJECT / "POTCAR")
+    enmax_text = f"source={potcar_src}\nENMAX={enmax}\nENCUT={ENCUT_EV}\nENCUT_over_ENMAX={ENCUT_EV / enmax if enmax else 'unknown'}\n"
+    (PROJECT / "potcar_enmax.txt").write_text(enmax_text)
+
+    link = PROJECT / "_perf_append.py"
+    if link.exists() or link.is_symlink():
+        link.unlink()
+    link.symlink_to("../../_perf_append.py")
+
+    summary = f"""
+- prompt: Compute the electronic band structure of bulk silicon diamond with PBE in VASP 6.6.0 along L-G-X-W-K-G and cross-validate against the QE baseline.
+-procedures: Generated VASP SCF and non-SCF band input files for Si diamond primitive cell (`a={A_ANG:.2f} Angstrom`, 2 atoms), Gamma-centered `8x8x8` SCF mesh, `ENCUT={ENCUT_EV} eV`, `EDIFF={EDIFF}`, Gaussian smearing `SIGMA=0.05`, and line-mode `L-G-X-W-K-G` band path with {POINTS_PER_SEGMENT} points/segment. Pending SLURM execution.
+- generated data: pending
+- generated figure: pending
+- status: blocked
+"""
+    write(PROJECT / "summary.md", summary)
+
+    print(f"Generated inputs in {PROJECT}")
+    print(f"POTCAR source: {potcar_src}")
+    print((PROJECT / "potcar_enmax.txt").read_text().strip())
+
+
+if __name__ == "__main__":
+    main()
