@@ -0,0 +1,328 @@
+#!/usr/bin/env python3
+"""Analyze VASP Si band output, write band_analysis.json, and plot bands.png."""
+
+from __future__ import annotations
+
+import json
+import math
+import re
+from pathlib import Path
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import numpy as np
+
+
+PROJECT = Path(__file__).resolve().parent
+
+A_ANG = 5.43
+POINTS_PER_SEGMENT = 36
+N_OCCUPIED_BANDS = 4
+GAP_ACCEPTANCE_EV = (0.5, 0.8)
+QE_REFERENCE_GAP_EV = 0.575
+K_NODES = [
+    ("L", np.array((0.5, 0.5, 0.5))),
+    ("G", np.array((0.0, 0.0, 0.0))),
+    ("X", np.array((0.5, 0.0, 0.5))),
+    ("W", np.array((0.5, 0.25, 0.75))),
+    ("K", np.array((0.375, 0.375, 0.75))),
+    ("G", np.array((0.0, 0.0, 0.0))),
+]
+
+
+def reciprocal_matrix() -> np.ndarray:
+    half = A_ANG / 2.0
+    lattice = np.array(
+        [
+            [0.0, half, half],
+            [half, 0.0, half],
+            [half, half, 0.0],
+        ]
+    )
+    return 2.0 * math.pi * np.linalg.inv(lattice).T
+
+
+def parse_eigenval(path: Path) -> tuple[list[list[float]], list[list[float]], int, int]:
+    lines = path.read_text(errors="ignore").splitlines()
+    if len(lines) < 7:
+        raise RuntimeError(f"{path} is too short to be a VASP EIGENVAL file")
+    header = lines[5].split()
+    if len(header) < 3:
+        raise RuntimeError(f"Could not parse electron/k-point/band counts from {path}")
+    nelect = int(float(header[0]))
+    nkpts = int(header[1])
+    nbands = int(header[2])
+
+    kcoords: list[list[float]] = []
+    energies_by_k: list[list[float]] = []
+    i = 6
+    for _ in range(nkpts):
+        while i < len(lines) and not lines[i].strip():
+            i += 1
+        if i >= len(lines):
+            raise RuntimeError("Unexpected end of EIGENVAL while reading k-points")
+        parts = lines[i].split()
+        if len(parts) < 4:
+            raise RuntimeError(f"Malformed k-point line in EIGENVAL: {lines[i]}")
+        kcoords.append([float(parts[0]), float(parts[1]), float(parts[2])])
+        i += 1
+
+        energies = []
+        for _ in range(nbands):
+            while i < len(lines) and not lines[i].strip():
+                i += 1
+            parts = lines[i].split()
+            if len(parts) < 2:
+                raise RuntimeError(f"Malformed eigenvalue line in EIGENVAL: {lines[i]}")
+            energies.append(float(parts[1]))
+            i += 1
+        energies_by_k.append(energies)
+
+    return kcoords, energies_by_k, nelect, nbands
+
+
+def cumulative_distances(kcoords: list[list[float]]) -> list[float]:
+    rec = reciprocal_matrix()
+    cart = [np.array(k) @ rec for k in kcoords]
+    xs = [0.0]
+    for previous, current in zip(cart[:-1], cart[1:]):
+        xs.append(xs[-1] + float(np.linalg.norm(current - previous)))
+    return xs
+
+
+def label_for_kpoint(kcoord: list[float]) -> str | None:
+    point = np.array(kcoord)
+    for label, coord in K_NODES:
+        if np.linalg.norm(point - coord) < 1.0e-6:
+            return label
+    return None
+
+
+def segment_for_kpoint(kcoord: list[float]) -> dict[str, object]:
+    point = np.array(kcoord)
+    for (label_a, a), (label_b, b) in zip(K_NODES[:-1], K_NODES[1:]):
+        delta = b - a
+        active = np.abs(delta) > 1.0e-12
+        if not np.any(active):
+            continue
+        t_values = (point[active] - a[active]) / delta[active]
+        t = float(np.mean(t_values))
+        if -1.0e-6 <= t <= 1.0 + 1.0e-6 and np.linalg.norm(a + t * delta - point) < 1.0e-6:
+            return {
+                "segment": f"{label_a}-{label_b}",
+                "from": label_a,
+                "to": label_b,
+                "fraction": max(0.0, min(1.0, t)),
+            }
+    return {"segment": None, "from": None, "to": None, "fraction": None}
+
+
+def band_extrema(kcoords: list[list[float]], energies_by_k: list[list[float]]) -> tuple[dict, dict, float]:
+    vbm = {"energy_ev": -math.inf}
+    cbm = {"energy_ev": math.inf}
+    for ik, (kcoord, energies) in enumerate(zip(kcoords, energies_by_k)):
+        for ib, energy in enumerate(energies, start=1):
+            record = {
+                "energy_ev": energy,
+                "band_index_1based": ib,
+                "k_index": ik,
+                "kpoint_reciprocal": kcoord,
+                "label": label_for_kpoint(kcoord),
+                "path_location": segment_for_kpoint(kcoord),
+            }
+            if ib <= N_OCCUPIED_BANDS and energy > vbm["energy_ev"]:
+                vbm = record
+            if ib > N_OCCUPIED_BANDS and energy < cbm["energy_ev"]:
+                cbm = record
+    return vbm, cbm, cbm["energy_ev"] - vbm["energy_ev"]
+
+
+def parse_scf_iterations(path: Path) -> int | None:
+    if not path.exists():
+        return None
+    text = path.read_text(errors="ignore")
+    matches = re.findall(r"^-+ Iteration\s+\d+\(\s*(\d+)\)", text, re.M)
+    return len(matches) or None
+
+
+def parse_outcar_times(path: Path) -> dict[str, float | None]:
+    if not path.exists():
+        return {"total_cpu_sec": None, "elapsed_real_sec": None}
+    text = path.read_text(errors="ignore")
+    cpu = re.search(r"Total CPU time used \(sec\):\s*([0-9.]+)", text)
+    elapsed = re.search(r"Elapsed time \(sec\):\s*([0-9.]+)", text)
+    return {
+        "total_cpu_sec": float(cpu.group(1)) if cpu else None,
+        "elapsed_real_sec": float(elapsed.group(1)) if elapsed else None,
+    }
+
+
+def parse_stage_times(path: Path) -> dict[str, dict[str, float | int]]:
+    stages: dict[str, dict[str, float | int]] = {}
+    if not path.exists():
+        return stages
+    for line in path.read_text().splitlines():
+        parts = line.split("\t")
+        if len(parts) < 4:
+            continue
+        name, start, end, status = parts[:4]
+        try:
+            stages[name] = {
+                "elapsed_sec": round(float(end) - float(start), 3),
+                "exit": int(status),
+            }
+        except ValueError:
+            continue
+    return stages
+
+
+def try_pymatgen_gap() -> dict[str, object]:
+    try:
+        from pymatgen.io.vasp.outputs import BSVasprun
+
+        vasprun = BSVasprun(str(PROJECT / "vasprun_band.xml"), parse_projected_eigen=False)
+        band_structure = vasprun.get_band_structure(
+            kpoints_filename=str(PROJECT / "KPOINTS_band"), line_mode=True
+        )
+        gap = band_structure.get_band_gap()
+        vbm = band_structure.get_vbm()
+        cbm = band_structure.get_cbm()
+        return {
+            "available": True,
+            "gap": gap,
+            "vbm_energy_ev": vbm.get("energy"),
+            "cbm_energy_ev": cbm.get("energy"),
+        }
+    except Exception as exc:
+        return {"available": False, "error": f"{exc.__class__.__name__}: {exc}"}
+
+
+def make_plot(xs: list[float], energies_by_k: list[list[float]], vbm: dict, cbm: dict, gap_ev: float) -> None:
+    tick_indices = [0]
+    tick_labels = [K_NODES[0][0]]
+    for inode, (label, _coord) in enumerate(K_NODES[1:], start=1):
+        tick_indices.append(inode * POINTS_PER_SEGMENT - 1)
+        tick_labels.append(label)
+    tick_positions = [xs[i] for i in tick_indices if i < len(xs)]
+    tick_labels = tick_labels[: len(tick_positions)]
+    plot_labels = [r"$\Gamma$" if label == "G" else label for label in tick_labels]
+
+    bands_by_band = list(zip(*energies_by_k))
+    fig, ax = plt.subplots(figsize=(7.2, 4.8), dpi=180)
+    for band in bands_by_band:
+        ax.plot(xs, [energy - vbm["energy_ev"] for energy in band], color="black", lw=0.85)
+    for xpos in tick_positions:
+        ax.axvline(xpos, color="0.78", lw=0.7)
+    ax.axhline(0.0, color="#2563eb", lw=0.8, ls="--")
+    ax.scatter([xs[vbm["k_index"]]], [0.0], color="#2563eb", s=22, zorder=4)
+    ax.scatter(
+        [xs[cbm["k_index"]]],
+        [cbm["energy_ev"] - vbm["energy_ev"]],
+        color="#dc2626",
+        s=22,
+        zorder=4,
+    )
+    ax.text(
+        0.985,
+        0.96,
+        f"Indirect gap = {gap_ev:.3f} eV",
+        ha="right",
+        va="top",
+        transform=ax.transAxes,
+        fontsize=9,
+    )
+    ax.set_xlim(min(xs), max(xs))
+    ax.set_ylim(-5.0, 5.0)
+    ax.set_xticks(tick_positions, plot_labels)
+    ax.set_ylabel("Energy - VBM (eV)")
+    ax.set_xlabel("Lattice wave vector")
+    ax.set_title("Si diamond PBE band structure (VASP)")
+    ax.grid(axis="y", color="0.88", lw=0.5)
+    fig.tight_layout()
+    fig.savefig(PROJECT / "bands.png")
+    plt.close(fig)
+
+
+def write_summary(analysis: dict) -> None:
+    status = "done" if analysis["success_criteria_met"] else "failed"
+    vbm_label = analysis["vbm"].get("label") or analysis["vbm"]["path_location"]["segment"]
+    cbm_loc = analysis["cbm"]["path_location"]
+    summary = f"""
+- prompt: Compute the electronic band structure of bulk silicon diamond with PBE in VASP 6.6.0 along L-G-X-W-K-G and cross-validate against the QE baseline.
+-procedures: Generated VASP inputs for SCF (`8x8x8` Gamma-centered, `ENCUT=400 eV`, `EDIFF=1e-6`, `ISMEAR=0`, `SIGMA=0.05`, `LCHARG=.TRUE.`, `KPAR=2`, `NCORE=4`) and non-SCF band calculation (`ICHARG=11`, `NBANDS=12`, 36 points/segment line-mode `L-G-X-W-K-G` path). Ran the single-node SLURM chain with `oneapi/2024.2.0`, `vasp/6.6.0-oneapi.2024.2.0`, `--nodes=1 --ntasks=1 --cpus-per-task=8`, and `mpirun -np "${{SLURM_CPUS_PER_TASK}}"`.
+- generated data: `OUTCAR_scf`, `OUTCAR_band`, `vasprun_scf.xml`, `vasprun_band.xml`, `EIGENVAL`, `band_analysis.json`, `stage_times.tsv`, `module_list.txt`; SCF electronic iterations = {analysis["scf_iterations"]}, indirect gap = {analysis["indirect_gap_ev"]:.6f} eV.
+- generated figure: `bands.png`
+- key result: VBM at {vbm_label}, CBM on {cbm_loc["segment"]} at fraction {cbm_loc["fraction"]:.6f}; QE reference gap = {QE_REFERENCE_GAP_EV:.3f} eV, VASP-QE gap delta = {analysis["qe_gap_delta_ev"]:.6f} eV.
+- status: {status}
+"""
+    if not analysis["success_criteria_met"]:
+        summary += (
+            f"-debugging clue: success criteria failed; gap_in_window={analysis['gap_in_acceptance_window']}, "
+            f"topology_matches_qe={analysis['topology_matches_qe']}, scf_converged_within_30={analysis['scf_converged_within_30']}.\n"
+            "-suggested skills updates: add an automatic convergence investigation branch when Si PBE gap falls outside 0.5-0.8 eV or differs from QE by more than 0.1 eV.\n"
+        )
+    (PROJECT / "summary.md").write_text(summary.strip() + "\n")
+
+
+def main() -> None:
+    kcoords, energies_by_k, nelect, nbands = parse_eigenval(PROJECT / "EIGENVAL")
+    xs = cumulative_distances(kcoords)
+    vbm, cbm, gap_ev = band_extrema(kcoords, energies_by_k)
+    make_plot(xs, energies_by_k, vbm, cbm, gap_ev)
+
+    stage_times = parse_stage_times(PROJECT / "stage_times.tsv")
+    scf_iterations = parse_scf_iterations(PROJECT / "OUTCAR_scf")
+    scf_times = parse_outcar_times(PROJECT / "OUTCAR_scf")
+    band_times = parse_outcar_times(PROJECT / "OUTCAR_band")
+    qe_gap_delta = abs(gap_ev - QE_REFERENCE_GAP_EV)
+    cbm_path = cbm["path_location"]
+    gap_in_window = GAP_ACCEPTANCE_EV[0] <= gap_ev <= GAP_ACCEPTANCE_EV[1]
+    topology_matches = (
+        (vbm.get("label") == "G")
+        and cbm_path.get("segment") == "G-X"
+        and cbm_path.get("fraction") is not None
+        and 0.70 <= float(cbm_path["fraction"]) <= 0.95
+    )
+    analysis = {
+        "system": "Si_diamond_PBE_band_vasp",
+        "n_electrons": nelect,
+        "n_kpoints": len(kcoords),
+        "n_bands": nbands,
+        "occupied_bands_assumed": N_OCCUPIED_BANDS,
+        "vbm": vbm,
+        "cbm": cbm,
+        "indirect_gap_ev": gap_ev,
+        "acceptance_window_ev": list(GAP_ACCEPTANCE_EV),
+        "gap_in_acceptance_window": gap_in_window,
+        "qe_reference_gap_ev": QE_REFERENCE_GAP_EV,
+        "qe_gap_delta_ev": qe_gap_delta,
+        "qe_gap_delta_within_0p1_ev": qe_gap_delta <= 0.1,
+        "topology_matches_qe": topology_matches,
+        "scf_iterations": scf_iterations,
+        "scf_converged_within_30": scf_iterations is not None and scf_iterations <= 30,
+        "walltime": {
+            "stage_times": stage_times,
+            "outcar_scf": scf_times,
+            "outcar_band": band_times,
+        },
+        "pymatgen_bsvasprun": try_pymatgen_gap(),
+        "plot": "bands.png",
+        "parsed_source": "EIGENVAL",
+    }
+    analysis["success_criteria_met"] = (
+        analysis["gap_in_acceptance_window"]
+        and analysis["topology_matches_qe"]
+        and analysis["scf_converged_within_30"]
+    )
+
+    (PROJECT / "band_analysis.json").write_text(json.dumps(analysis, indent=2) + "\n")
+    write_summary(analysis)
+    print(json.dumps(analysis, indent=2))
+    if not analysis["success_criteria_met"]:
+        raise SystemExit("VASP Si band success criteria were not met")
+
+
+if __name__ == "__main__":
+    main()
