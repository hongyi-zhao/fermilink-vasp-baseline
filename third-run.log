#!/bin/bash
#SBATCH --job-name=si-qe-band
#SBATCH --partition=batch
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=24:00:00
#SBATCH --output=slurm-%j.out
#SBATCH --error=slurm-%j.err

ulimit -Sn $(ulimit -Hn) 2>/dev/null || true
ulimit -s unlimited 2>/dev/null || true

set -euo pipefail

cd "${SLURM_SUBMIT_DIR}"

export FL_SYSTEM_TAG=Si_diamond_PBE_band_qe
export OMP_NUM_THREADS=1

module load oneapi/2024.2.0
module load q-e/develop-oneapi.2024.2.0
module list > module_list.txt 2>&1

rm -f stage_times.tsv scf.out bands.out bandsx.out bands.dat bands.dat.gnu band_analysis.json bands.png
rm -rf tmp
mkdir -p tmp

stage() {
    local name="$1"
    local outfile="$2"
    shift 2
    local start_epoch end_epoch status
    start_epoch=$(date +%s)
    set +e
    "$@" > "${outfile}"
    status=$?
    set -e
    end_epoch=$(date +%s)
    printf "%s\t%s\t%s\t%s\n" "${name}" "${start_epoch}" "${end_epoch}" "${status}" >> stage_times.tsv
    return "${status}"
}

stage scf scf.out mpirun -np "${SLURM_CPUS_PER_TASK}" pw.x -nk 2 -in scf.in
stage bands bands.out mpirun -np "${SLURM_CPUS_PER_TASK}" pw.x -nk 2 -in bands.in
stage bandsx bandsx.out mpirun -np "${SLURM_CPUS_PER_TASK}" bands.x -in bandsx.in
stage postprocess postprocess.out python3 postprocess_bands.py
./_perf_append.py > perf_append.out 2> perf_append.err
