#!/usr/bin/env python3
"""Generate Quantum ESPRESSO inputs for the Si PBE band-structure smoke test."""

import json
import math
from pathlib import Path


A_ANG = 5.43
BOHR_PER_ANG = 1.889726124565062
CELLDMM1_BOHR = A_ANG * BOHR_PER_ANG
POINTS_PER_SEGMENT = 36

PREFIX = "si"
PSEUDO_FILE = "Si.pbe-n-rrkjus_psl.1.0.0.UPF"

# Cartesian reciprocal coordinates in units of 2*pi/a for the fcc Brillouin zone.
K_NODES = [
    ("L", (0.5, 0.5, 0.5)),
    ("G", (0.0, 0.0, 0.0)),
    ("X", (0.0, 1.0, 0.0)),
    ("W", (0.5, 1.0, 0.0)),
    ("K", (0.75, 0.75, 0.0)),
    ("G", (0.0, 0.0, 0.0)),
]


def interpolate_path(nodes, points_per_segment):
    kpoints = []
    labels = []
    label_indices = []
    cumulative = []
    total = 0.0

    for iseg, ((label_a, a), (label_b, b)) in enumerate(zip(nodes[:-1], nodes[1:])):
        if iseg == 0:
            labels.append(label_a)
            label_indices.append(0)

        for i in range(points_per_segment):
            if iseg > 0 and i == 0:
                continue
            t = i / (points_per_segment - 1)
            point = tuple((1.0 - t) * a[j] + t * b[j] for j in range(3))
            if kpoints:
                prev = kpoints[-1]
                total += math.dist(prev, point)
            kpoints.append(point)
            cumulative.append(total)

        labels.append(label_b)
        label_indices.append(len(kpoints) - 1)

    return kpoints, cumulative, labels, label_indices


def write(path, text):
    path.write_text(text.strip() + "\n")


def main():
    root = Path(__file__).resolve().parent
    kpoints, cumulative, labels, label_indices = interpolate_path(
        K_NODES, POINTS_PER_SEGMENT
    )

    scf = f"""
&CONTROL
  calculation = 'scf',
  prefix = '{PREFIX}',
  outdir = './tmp',
  pseudo_dir = './pseudo',
  verbosity = 'high',
/
&SYSTEM
  ibrav = 2,
  celldm(1) = {CELLDMM1_BOHR:.10f},
  nat = 2,
  ntyp = 1,
  ecutwfc = 30.0,
  ecutrho = 240.0,
  input_dft = 'PBE',
  occupations = 'fixed',
/
&ELECTRONS
  conv_thr = 1.0d-8,
  electron_maxstep = 80,
  mixing_beta = 0.7,
/
ATOMIC_SPECIES
  Si 28.0855 {PSEUDO_FILE}
ATOMIC_POSITIONS alat
  Si 0.0000000000 0.0000000000 0.0000000000
  Si 0.2500000000 0.2500000000 0.2500000000
K_POINTS automatic
  8 8 8 1 1 1
"""
    write(root / "scf.in", scf)

    k_lines = "\n".join(
        f"  {kx: .10f} {ky: .10f} {kz: .10f} 1.0" for kx, ky, kz in kpoints
    )
    bands = f"""
&CONTROL
  calculation = 'bands',
  prefix = '{PREFIX}',
  outdir = './tmp',
  pseudo_dir = './pseudo',
  verbosity = 'high',
/
&SYSTEM
  ibrav = 2,
  celldm(1) = {CELLDMM1_BOHR:.10f},
  nat = 2,
  ntyp = 1,
  ecutwfc = 30.0,
  ecutrho = 240.0,
  input_dft = 'PBE',
  occupations = 'fixed',
  nbnd = 8,
  nosym = .true.,
/
&ELECTRONS
  conv_thr = 1.0d-8,
  electron_maxstep = 80,
