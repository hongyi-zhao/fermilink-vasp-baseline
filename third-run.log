@@ -0,0 +1,97 @@
+#!/bin/bash
+#SBATCH --job-name=si-vasp-band
+#SBATCH --partition=batch
+#SBATCH --nodes=1
+#SBATCH --ntasks=1
+#SBATCH --cpus-per-task=8
+#SBATCH --time=24:00:00
+#SBATCH --output=slurm-%j.out
+#SBATCH --error=slurm-%j.err
+
+ulimit -Sn $(ulimit -Hn) 2>/dev/null || true
+ulimit -s unlimited 2>/dev/null || true
+
+set -eo pipefail
+
+cd "${SLURM_SUBMIT_DIR}"
+
+export FL_SYSTEM_TAG=Si_diamond_PBE_band_vasp
+export OMP_NUM_THREADS=1
+export VASP_PP="${VASP_PP:-/home/werner/Public/hpc/vasp/pot}"
+export PYTHON_BIN="${PYTHON_BIN:-/home/werner/.pyenv/versions/datasci/bin/python}"
+
+set +u
+module load oneapi/2024.2.0
+module load vasp/6.6.0-oneapi.2024.2.0
+set -u
+module list > module_list.txt 2>&1
+
+if [[ ! -x "${PYTHON_BIN}" ]]; then
+  echo "Missing Python interpreter: ${PYTHON_BIN}" >&2
+  exit 2
+fi
+if [[ ! -f "${VASP_PP}/potpaw_PBE/Si/POTCAR" ]]; then
+  echo "Missing ${VASP_PP}/potpaw_PBE/Si/POTCAR" >&2
+  exit 2
+fi
+
+rm -f stage_times.tsv prepare.out vasp_scf.out vasp_band.out postprocess.out perf_append.out perf_append.err
+rm -f OUTCAR OUTCAR_scf OUTCAR_band OSZICAR OSZICAR_scf OSZICAR_band
+rm -f vasprun.xml vasprun_scf.xml vasprun_band.xml EIGENVAL PROCAR DOSCAR REPORT XDATCAR PCDAT IBZKPT
+rm -f band_analysis.json bands.png
+
+stage() {
+    local name="$1"
+    local outfile="$2"
+    shift 2
+    local start_epoch end_epoch status
+    start_epoch=$(date +%s)
+    set +e
+    "$@" > "${outfile}"
+    status=$?
+    set -e
+    end_epoch=$(date +%s)
+    printf "%s\t%s\t%s\t%s\n" "${name}" "${start_epoch}" "${end_epoch}" "${status}" >> stage_times.tsv
+    return "${status}"
+}
+
+prepare() {
+    "${PYTHON_BIN}" generate_inputs.py
+    grep ENMAX POTCAR | tee potcar_enmax_grep.txt
+}
+
+run_scf() {
+    cp INCAR_scf INCAR
+    cp KPOINTS_scf KPOINTS
+    rm -f OUTCAR OSZICAR vasprun.xml EIGENVAL PROCAR DOSCAR REPORT XDATCAR PCDAT IBZKPT
+    mpirun -np "${SLURM_CPUS_PER_TASK}" vasp_std
+    cp OUTCAR OUTCAR_scf
+    cp OSZICAR OSZICAR_scf
+    cp vasprun.xml vasprun_scf.xml
+}
+
+run_band() {
+    cp INCAR_band INCAR
+    cp KPOINTS_band KPOINTS
+    rm -f OUTCAR OSZICAR vasprun.xml EIGENVAL PROCAR DOSCAR REPORT XDATCAR PCDAT IBZKPT
+    mpirun -np "${SLURM_CPUS_PER_TASK}" vasp_std
+    cp OUTCAR OUTCAR_band
+    cp OSZICAR OSZICAR_band
+    cp vasprun.xml vasprun_band.xml
+}
+
+postprocess() {
+    "${PYTHON_BIN}" postprocess_bands.py
+}
+
+append_perf() {
+    cp INCAR_scf INCAR
+    cp OUTCAR_scf OUTCAR
+    ./_perf_append.py 2> perf_append.err
+}
+
+stage prepare prepare.out prepare
+stage scf vasp_scf.out run_scf
+stage band vasp_band.out run_band
+stage postprocess postprocess.out postprocess
+stage perf_append perf_append.out append_perf
