index 0000000000000000000000000000000000000000..7b90b6781c2c73a7cc10256a308b96712cea3457
--- /dev/null
+++ b/projects/2026-05-02-si-bands-vasp/run.sh
@@ -0,0 +1,96 @@
+#!/bin/bash
+#SBATCH --job-name=si-bands-vasp
+#SBATCH --partition=batch
+#SBATCH --nodes=1
+#SBATCH --ntasks=1
+#SBATCH --cpus-per-task=8
+#SBATCH --time=24:00:00
+#SBATCH --output=slurm-%j.out
+#SBATCH --error=slurm-%j.err
+
+ulimit -Sn $(ulimit -Hn) 2>/dev/null; ulimit -s unlimited 2>/dev/null
+set -euo pipefail
+
+PROJECT_DIR="${SLURM_SUBMIT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
+cd "$PROJECT_DIR"
+
+export FL_SYSTEM_TAG=Si_diamond_PBE_band_vasp
+export VASP_PP=~/Public/hpc/vasp/pot
+PYTHON=/home/werner/.pyenv/versions/datasci/bin/python
+MPI_RUN=/opt/intel/oneapi/2024.2.0/mpi/2021.13/bin/mpirun
+VASP_STD=
+
+: > stage_times.tsv
+
+stage() {
+    local name="$1"
+    shift
+    local start end status
+    start=$(date +%s)
+    echo "[stage:${name}] start $(date -Is)"
+    set +e
+    (set -euo pipefail; "$@")
+    status=$?
+    set -e
+    end=$(date +%s)
+    printf "%s\t%s\t%s\t%s\n" "$name" "$start" "$end" "$status" >> stage_times.tsv
+    echo "[stage:${name}] end $(date -Is) status=${status} elapsed=$((end-start))s"
+    return "$status"
+}
+
+load_modules() {
+    set +u
+    module load oneapi/2024.2.0 > module_load.log 2>&1
+    module load vasp/6.6.0-oneapi.2024.2.0 >> module_load.log 2>&1
+    set -u
+    module list > module_list.txt 2>&1
+    VASP_STD="$(command -v vasp_std)"
+    printf "%s\n" "$VASP_STD" > vasp_std.path
+    printf "%s\n" "$MPI_RUN" > mpirun.path
+    "$MPI_RUN" --version > mpirun.version 2>&1
+}
+
+prepare_inputs() {
+    "$PYTHON" generate_inputs.py
+    grep ENMAX POTCAR > potcar_enmax.txt
+    cp INCAR_scf INCAR
+    cp KPOINTS_scf KPOINTS
+}
+
+run_scf() {
+    cp INCAR_scf INCAR
+    cp KPOINTS_scf KPOINTS
+    cat "$VASP_PP"/potpaw_PBE.64/Si/POTCAR > POTCAR
+    "$MPI_RUN" -np "${SLURM_CPUS_PER_TASK}" "$VASP_STD" > vasp_scf.out 2> vasp_scf.err
+    cp OUTCAR OUTCAR_scf
+    cp vasprun.xml vasprun_scf.xml
+    cp OSZICAR OSZICAR_scf
+    cp EIGENVAL EIGENVAL_scf
+}
+
+run_band() {
+    cp INCAR_band INCAR
+    cp KPOINTS_band KPOINTS
+    cat "$VASP_PP"/potpaw_PBE.64/Si/POTCAR > POTCAR
+    "$MPI_RUN" -np "${SLURM_CPUS_PER_TASK}" "$VASP_STD" > vasp_band.out 2> vasp_band.err
+    cp OUTCAR OUTCAR_band
+    cp vasprun.xml vasprun_band.xml
+    cp OSZICAR OSZICAR_band
+}
+
+postprocess() {
+    cp OUTCAR_scf OUTCAR
+    cp INCAR_scf INCAR
+    cp EIGENVAL_scf EIGENVAL_scf.saved
+    cp EIGENVAL EIGENVAL_band
+    "$PYTHON" postprocess_bands.py > postprocess.log 2>&1
+    ln -sfn ../../_perf_append.py _perf_append.py
+    "$PYTHON" _perf_append.py > perf_append.log 2>&1
+    cp OUTCAR_band OUTCAR
+}
+
+stage module load_modules
+stage prepare prepare_inputs
+stage scf run_scf
+stage band run_band
+stage postprocess postprocess
