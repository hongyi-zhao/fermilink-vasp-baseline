+        position = float(distances[idx])
+        if not label_positions or abs(position - label_positions[-1][0]) > 1e-7 or display != label_positions[-1][1]:
+            label_positions.append((position, display))
+
+    fig, ax = plt.subplots(figsize=(6.5, 4.2), constrained_layout=True)
+    for band in energies:
+        ax.plot(distances, band, color="#1f4e79", linewidth=1.0)
+    for pos, _label in label_positions:
+        ax.axvline(pos, color="0.75", linewidth=0.7)
+    ax.axhline(0.0, color="0.25", linewidth=0.8, linestyle="--")
+    ax.set_xlim(float(distances.min()), float(distances.max()))
+    ax.set_ylim(-12, 8)
+    ax.set_ylabel("Energy - VBM (eV)")
+    ax.set_xticks([p for p, _ in label_positions])
+    ax.set_xticklabels([lab for _, lab in label_positions])
+    ax.set_title("Si PBE band structure (VASP)")
+    ax.grid(axis="y", color="0.9", linewidth=0.5)
+    fig.savefig(PROJECT / "bands.png", dpi=220)
+    plt.close(fig)
+
+    vbm_kpoints = vbm.get("kpoint", [])
+    cbm_kpoints = cbm.get("kpoint", [])
+    vbm_k = vbm_kpoints[0] if vbm_kpoints else None
+    cbm_k = cbm_kpoints[0] if cbm_kpoints else None
+
+    gamma = np.array([0.0, 0.0, 0.0])
+    x_point = np.array([0.5, 0.0, 0.5])
+    cbm_frac = np.array(cbm_k.frac_coords, dtype=float) if cbm_k is not None else np.array([math.nan] * 3)
+    gamma_x_fraction = float(np.dot(cbm_frac - gamma, x_point - gamma) / np.dot(x_point - gamma, x_point - gamma))
+
+    analysis = {
+        "system": "Si_diamond_PBE_band_vasp",
+        "vasprun_source": vasprun.name,
+        "band_gap_ev": round(float(gap["energy"]), 6),
+        "is_direct": bool(gap["direct"]),
+        "transition": gap.get("transition"),
+        "vbm_energy_ev": round(float(vbm["energy"]), 6),
+        "cbm_energy_ev": round(float(cbm["energy"]), 6),
+        "vbm_label": kpoint_label(vbm_k) if vbm_k is not None else None,
+        "cbm_label": kpoint_label(cbm_k) if cbm_k is not None else None,
+        "vbm_frac_coords": format_frac(vbm_k.frac_coords) if vbm_k is not None else None,
+        "cbm_frac_coords": format_frac(cbm_k.frac_coords) if cbm_k is not None else None,
+        "cbm_gamma_x_fraction": round(gamma_x_fraction, 6),
+        "qe_reference_gap_ev": QE_GAP_EV,
+        "gap_minus_qe_ev": round(float(gap["energy"]) - QE_GAP_EV, 6),
+        "scf_iter": parse_scf_iter(PROJECT / "OUTCAR_scf"),
+        "scf_elapsed_sec": parse_elapsed(PROJECT / "OUTCAR_scf"),
+        "band_elapsed_sec": parse_elapsed(PROJECT / "OUTCAR_band"),
+        "stage_times": load_stage_times(PROJECT / "stage_times.tsv"),
+        "validation": {
+            "gap_in_expected_range_0p5_0p8": 0.5 <= float(gap["energy"]) <= 0.8,
+            "vbm_at_gamma": kpoint_label(vbm_k) == "G" if vbm_k is not None else False,
+            "cbm_near_gamma_x": 0.7 <= gamma_x_fraction <= 1.0,
+            "scf_iter_le_30": (parse_scf_iter(PROJECT / "OUTCAR_scf") or 999) <= 30,
+        },
+    }
+    (PROJECT / "band_analysis.json").write_text(json.dumps(analysis, indent=2) + "\n")
+    print(json.dumps(analysis, indent=2))
+
+
+if __name__ == "__main__":
+    main()
